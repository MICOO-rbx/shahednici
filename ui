Other:Button({

Title = "Подсветить создателя",
Callback = function()

local Players = game:GetService("Players")
local creatorId = game.CreatorId
local function applyHighlight(character)
	if character:FindFirstChild("CreatorHighlight") then return end

	local highlight = Instance.new("Highlight")
	highlight.Name = "CreatorHighlight"
	highlight.Adornee = character
	highlight.FillColor = Color3.fromRGB(255, 215, 0)
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = 0.5
	highlight.OutlineTransparency = 0
	highlight.Parent = character
end

local function onPlayerAdded(player)
	-- Проверяем, является ли игрок создателем
	if player.UserId == creatorId then
		if player.Character then
			applyHighlight(player.Character)
		end
		player.CharacterAdded:Connect(applyHighlight)
	end
end
for _, player in ipairs(Players:GetPlayers()) do
	onPlayerAdded(player)
end
Players.PlayerAdded:Connect(onPlayerAdded)


end

})
