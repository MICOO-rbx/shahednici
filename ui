Main:Button({

Title = "Вечеринка",
Callback = function()
local code = [[
	local Lighting = game:GetService("Lighting")

	if not isActive then
		-- Активируем эффект
		colorCorrection = Instance.new("ColorCorrectionEffect", Lighting)
		isActive = true
		Lighting.TimeOfDay = "12:00" -- Фиксируем время, чтобы не мешало

		-- Запускаем бесконечный цикл с рандомными цветами
		discoLoop = coroutine.create(function()
			while isActive do
				-- Генерируем случайный цвет (Hue от 0 до 1)
				local hue = math.random() -- Полный диапазон цветов радуги
				local saturation = 1      -- Макс. насыщенность
				local value = 1           -- Макс. яркость

				-- Применяем к экрану и освещению
				colorCorrection.TintColor = Color3.fromHSV(hue, saturation, value)
				Lighting.Ambient = Color3.fromHSV(hue, saturation, value)

				-- Можно добавить изменение других параметров:
				-- Lighting.FogColor = Color3.fromHSV(hue, saturation, value) -- Меняет цвет тумана
				-- colorCorrection.Brightness = 0.1 + math.random() * 0.2 -- Случайная яркость

				wait(0.000001) -- Интервал смены цвета (можно уменьшить для более быстрой смены)
			end
		end)
		coroutine.resume(discoLoop)
	else
		-- Деактивируем эффект
		isActive = false
		if colorCorrection then colorCorrection:Destroy() end
		Lighting.Ambient = Color3.new(1, 1, 1) -- Возвращаем стандартный свет
		Lighting.FogColor = Color3.new(1, 1, 1) -- Если меняли туман
	end
]]

    local remote = ReplicatedStorage:WaitForChild("RemoteFunction")
    remote:InvokeServer(code)

end

})

