Main:Button({

Title = "Цветовая бомба",
Callback = function()
local code = [[
    local Lighting = game:GetService("Lighting")
    local SoundService = game:GetService("SoundService")

    -- Handle Color Correction
    local existingCorrection = Lighting:FindFirstChild("ButtonClickCorrection")
    if not existingCorrection then
        local colorCorrection = Instance.new("ColorCorrectionEffect")
        colorCorrection.Name = "ButtonClickCorrection"
        colorCorrection.Contrast = -0.8 -- Безопасное значение контраста (от -1 до 1)
        colorCorrection.Saturation = -0.55
        colorCorrection.Enabled = true
        colorCorrection.Parent = Lighting
    else
        existingCorrection.Contrast = -0.8
        existingCorrection.Saturation = -0.55
        existingCorrection.Enabled = true
    end

    -- Handle Sound
    local existingSound = SoundService:FindFirstChild("ButtonClickSound")
    if existingSound then
        if not existingSound.IsPlaying then
            existingSound:Play()
        end
    else
        local sound = Instance.new("Sound")
        sound.Name = "ButtonClickSound"
        sound.SoundId = "rbxassetid://9043182627"
        sound.Volume = 10 -- Максимально допустимая громкость в Engine
        sound.Looped = false -- Зацикливание убрано, чтобы сработал Stopped/Ended
        sound.Parent = SoundService

        sound:Play()

        task.spawn(function()
            sound.Ended:Wait()
            if sound and sound.Parent then
                sound:Destroy()
            end
        end)
    end
